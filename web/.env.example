# ---------------------------------------------------------------------------
# Sign-in (Privy) -- https://dashboard.privy.io
# In the Privy dashboard: enable "Automatically create embedded wallets on
# login", choose EVM, and turn off external wallets.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional; leave blank unless your Privy app requires a client id.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# ---------------------------------------------------------------------------
# Sponsored transactions (Pimlico) -- https://dashboard.pimlico.io
# Create an API key, select the Monad Testnet RPC, and paste the bundler URL.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PIMLICO_BUNDLER_URL=

# ---------------------------------------------------------------------------
# Network. The default public endpoint works; override to use your own.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# ---------------------------------------------------------------------------
# Contracts. All optional -- config.ts already points at the live deployment.
# Set these only to run against your own, via ./scripts/deploy.sh.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_KOLO_REGISTRY_ADDRESS=
NEXT_PUBLIC_KOLO_PAY_ADDRESS=
# The dollar balance. Defaults to Agora AUSD on Monad Testnet.
NEXT_PUBLIC_TOKEN_ADDRESS=
# Our own faucet, which hands demo users $100 of the token above.
NEXT_PUBLIC_KOLO_FAUCET_ADDRESS=
# Claim links (KoloLinks). No default -- deploy it with
# contracts/script/DeployLinks.s.sol and paste the address here. Until this is
# set, the "Send a link instead" option stays hidden.
NEXT_PUBLIC_KOLO_LINKS_ADDRESS=
# Circles (KoloCircle). No default -- deploy with DeployCircle.s.sol. Until
# this is set, circles stay hidden.
NEXT_PUBLIC_KOLO_CIRCLE_ADDRESS=
# Block the contracts were deployed at; bounds how far back the feed scans.
NEXT_PUBLIC_KOLO_DEPLOY_BLOCK=
# Phase 4. Optional -- config.ts already points at the live deployment.
NEXT_PUBLIC_KOLO_GOALS_ADDRESS=
NEXT_PUBLIC_KOLO_POTS_ADDRESS=
# The mock premium service demo pots pay (@kolo_premium).
NEXT_PUBLIC_KOLO_DEMO_PAYEE=
