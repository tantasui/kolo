# ---------------------------------------------------------------------------
# Sign-in (Privy) -- https://dashboard.privy.io
# In the Privy dashboard: enable "Automatically create embedded wallets on
# login", choose EVM, and turn off external wallets.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional; leave blank unless your Privy app requires a client id.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# ---------------------------------------------------------------------------
# Sponsored transactions (Pimlico) -- https://dashboard.pimlico.io
# Create an API key, select the Monad Testnet RPC, and paste the bundler URL.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PIMLICO_BUNDLER_URL=

# ---------------------------------------------------------------------------
# Network. The default public endpoint works; override to use your own.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# ---------------------------------------------------------------------------
# Contracts -- printed by `forge script script/Deploy.s.sol:Deploy --broadcast`
# ---------------------------------------------------------------------------
NEXT_PUBLIC_KOLO_REGISTRY_ADDRESS=
NEXT_PUBLIC_KOLO_PAY_ADDRESS=
NEXT_PUBLIC_TEST_USD_ADDRESS=
# Block the contracts were deployed at; bounds how far back the feed scans.
NEXT_PUBLIC_KOLO_DEPLOY_BLOCK=0
